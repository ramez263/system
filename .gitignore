# Root .gitignore for Ramez Tunnel Plus Monorepo

# Operating System Files
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp

# IDEs
.idea/
.vscode/
*.iml

# Flutter / Dart
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.pub-cache/
apps/mobile/.pub/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/build/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Pods/
apps/mobile/ios/Podfile.lock

# Laravel / PHP
apps/backend/vendor/
apps/backend/node_modules/
apps/backend/.env
apps/backend/.env.backup
apps/backend/.env.production
apps/backend/storage/*.key
apps/backend/storage/oauth-*.key
apps/backend/storage/logs/*.log
apps/backend/storage/framework/cache/data/*
apps/backend/storage/framework/sessions/*
apps/backend/storage/framework/views/*
apps/backend/bootstrap/cache/*.php

# Docker
.docker/
docker-compose.override.yml
